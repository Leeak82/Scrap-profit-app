# Copy this file to .env on your backend host.
# Non-eBay live search providers. Add one or more.

# Option A: Brave Search API for broad web results/snippets
BRAVE_API_KEY=your_brave_search_api_key_here

# Option B: SerpApi Google Shopping for stronger shopping/price cards
SERPAPI_KEY=your_serpapi_key_here

# Option C: Google Custom Search JSON API
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CX=your_google_programmable_search_engine_id_here

# Use your GitHub Pages URL here after deployment.
ALLOWED_ORIGIN=https://leeak82.github.io
PORT=3000
